// PasteShare — Prisma schema (SQLite dialect)
// Enums are represented as String columns with app-level validation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  displayName     String?
  role            String   @default("user") // denormalized: "user" | "moderator" | "admin"
  roleId          String?  // FK to Role (RBAC)
  roleRef         Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  status          String   @default("active") // "pending_verification" | "active" | "suspended" | "banned"
  emailVerifiedAt DateTime?
  apiKey          String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pastes       Paste[]
  accessGrants PasteAccessGrant[]
  auditLogs    AuditLog[]
  subscriptions Subscription[]
  usageRecord  UsageRecord?
  payments     Payment[]
  invoices     Invoice[]
}

model Paste {
  id               String    @id @default(cuid())
  ownerId          String?
  owner            User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  title            String?
  slug             String    @unique
  contentType      String    @default("text") // "text" | "file"
  language         String    @default("plaintext")
  textContent      String?
  storageDriver    String? // "local" | "s3"
  storageKey       String?
  originalFileName String?
  mimeType         String?
  fileSizeBytes    Int?
  visibility       String    @default("public") // "public" | "unlisted" | "private"
  passwordHash     String?
  burnAfterRead    Boolean   @default(false)
  isBurned         Boolean   @default(false)
  viewCount        Int       @default(0)
  expiresAt        DateTime?
  isDeleted        Boolean   @default(false)
  isFlagged        Boolean   @default(false)
  tags             String? // comma-separated
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accessGrants PasteAccessGrant[]

  @@index([ownerId])
  @@index([expiresAt])
  @@index([visibility])
  @@index([createdAt])
}

model PasteAccessGrant {
  id        String   @id @default(cuid())
  pasteId   String
  paste     Paste    @relation(fields: [pasteId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now())

  @@unique([pasteId, userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  metadata   String? // JSON string
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     String // JSON string for flexibility
  updatedAt DateTime @updatedAt
}

// ============================================================
// RBAC — Roles & Permissions
// ============================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // "user", "moderator", "admin", etc.
  description String?
  isSystem    Boolean  @default(false) // system roles can't be deleted
  color       String?  // UI accent color (e.g., "brand", "brand-2", "amber")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "paste:create", "paste:delete:any", "admin:access"
  description String?
  category    String   @default("general") // "paste", "file", "user", "admin", "subscription"
  createdAt   DateTime @default(now())

  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ============================================================
// Subscription Plans & Tracking
// ============================================================

model Plan {
  id                    String   @id @default(cuid())
  name                  String   @unique // "Free", "Pro", "Business"
  description           String?
  monthlyPrice          Float    @default(0) // in USD
  maxStorageBytes       BigInt   @default(104857600) // 100 MB default
  maxPasteSize          Int      @default(5242880) // 5 MB per paste/file
  maxPastesPerMonth     Int      @default(50)
  allowedExpiryPresets  String   @default("never,10m,1h,1d,1w,1M,1y") // comma-separated
  allowCustomExpiry     Boolean  @default(false)
  allowBurnAfterRead    Boolean  @default(true)
  allowPassword         Boolean  @default(true)
  allowPrivate          Boolean  @default(false)
  allowFileUpload       Boolean  @default(true)
  isSystem              Boolean  @default(false) // system plans can't be deleted
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  subscriptions Subscription[]
  payments     Payment[]
}

model Subscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId     String
  plan       Plan      @relation(fields: [planId], references: [id])
  status     String    @default("active") // "active", "expired", "cancelled", "suspended"
  startedAt  DateTime  @default(now())
  expiresAt  DateTime? // null = lifetime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model UsageRecord {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageBytes    BigInt   @default(0) // cached total storage used
  pasteCount      Int      @default(0) // cached active paste count
  fileCount       Int      @default(0) // cached active file count
  monthPasteCount Int      @default(0) // pastes created this month
  monthResetAt    DateTime @default(now()) // when monthly counter resets
  totalPastes     Int      @default(0) // all-time paste count
  totalViews      Int      @default(0) // all-time views on user's pastes
  updatedAt       DateTime @updatedAt
}

// ============================================================
// Ads System
// ============================================================

model Ad {
  id          String   @id @default(cuid())
  name        String   @unique // internal label
  slot        String   @default("sidebar") // "header" | "sidebar" | "footer" | "between-cards" | "paste-top" | "paste-bottom"
  adType      String   @default("html") // "html" | "image" | "adsense" | "custom"
  content     String   // HTML / ad code / image URL
  imageUrl    String?  // for image ads
  linkUrl     String?  // click-through URL
  isActive    Boolean  @default(true)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slot, isActive])
}

// ============================================================
// Payments & Invoices
// ============================================================

model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  planId          String
  plan            Plan     @relation(fields: [planId], references: [id])
  amount          Float    @default(0) // in USD
  currency        String   @default("USD")
  status          String   @default("pending") // "pending" | "completed" | "failed" | "refunded"
  method          String   @default("manual") // "manual" | "stripe" | "paypal" | "razorpay"
  txnId           String?  @unique // transaction/gateway ID
  invoiceNumber   String?  @unique
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoice         Invoice?

  @@index([userId])
  @@index([status])
  @@index([planId])
}

model Invoice {
  id          String   @id @default(cuid())
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  number      String   @unique
  amount      Float
  currency    String   @default("USD")
  planName    String
  periodStart DateTime
  periodEnd   DateTime?
  status      String   @default("issued") // "issued" | "paid" | "void"
  pdfKey      String?  // storage key for generated PDF
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([status])
}
