# ---------------------------------------------------------------------------
# ShareBin / PasteShare — environment configuration
# Copy to `.env` and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# SQLite database. Relative paths are resolved from the prisma/ directory,
# so this points at prisma/db/custom.db.
DATABASE_URL="file:./db/custom.db"

# Signs session cookies and paste unlock tokens. REQUIRED in production.
# Must be 32+ random characters:  openssl rand -hex 32
# Changing it signs everyone out and invalidates outstanding unlock tokens.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Where uploaded files are stored (default: ./storage)
STORAGE_LOCAL_ROOT="./storage"

# Public base URL used to build share links when the admin "canonicalUrl"
# setting is empty (otherwise the request's own host is used).
APP_URL="https://your-domain.com"

# Protects /api/cron/* — send as `Authorization: Bearer <secret>`.
# Leave empty to keep the endpoints open (not recommended in production).
CRON_SECRET=""

# --- Optional / advanced ----------------------------------------------------

# Log every SQL query (very noisy). 1 = on.
PRISMA_LOG_QUERIES=""

# Return password-reset tokens in the API response even in production.
# ONLY for demos with no mail delivery: anyone can then reset any account.
ALLOW_INSECURE_RESET_TOKENS=""

# Send cookies without the Secure flag in production (e.g. plain-HTTP intranet).
INSECURE_COOKIES=""

# SMTP — used once you wire a mailer into src/lib/mailer.ts
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
